    <string name="create_master_key_confirm_backup_invalid_error">The clipboard does not contain a supported encrypted Ed25519 OpenSSH private key.</string>
    <string name="create_master_key_confirm_backup_mismatch_error">This MasterKey does not match the backup you just exported.</string>

    <!-- Create MasterKey flow: step 6, transcribe Brave recovery word positions -->
    <string name="create_master_key_secret_combinations_title">Secret Combinations</string>
    <string name="create_master_key_secret_combinations_warning_title">Keep these combinations safe</string>
    <string name="create_master_key_secret_combinations_warning_body">Write down all 8 combinations and store them offline. Vault cannot restore them if they are lost.</string>
    <string name="create_master_key_secret_combinations_instruction">Scroll to view all 8 combinations</string>
    <string name="create_master_key_secret_combinations_consent">I have saved all 8 secret combinations</string>
    <string name="create_master_key_secret_combinations_confirm">Continue</string>
    <string name="create_master_key_secret_combinations_unavailable">Secret Combinations are unavailable. Restart Vault and try again.</string>

