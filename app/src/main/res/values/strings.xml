    <string name="create_master_key_creating_key">Creating your encrypted MasterKey…</string>
    <string name="create_master_key_saving_key">Saving your MasterKey securely on this device…</string>
    <string name="create_master_key_syncing_backups">Syncing your MasterKey account with backup sources…</string>
    <string name="create_master_key_syncing_backup_source">Syncing %1$s • %2$d of %3$d backup sources complete</string>

