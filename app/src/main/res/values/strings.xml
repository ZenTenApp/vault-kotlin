<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">Vault</string>

    <!-- Get started / first-run screen -->
    <string name="get_started_logo_description">ZenTen Vault logo</string>
    <string name="get_started_title">Vault by ZenTen</string>
    <string name="get_started_subtitle">Self-Custody SSH Key Manager</string>
    <string name="get_started_create_vault_key">Create VaultKey</string>
    <string name="get_started_recover_vault_key">Recover VaultKey</string>
    <string name="get_started_login_vault_key">Login with VaultKey</string>
    <string name="get_started_continue_with">or continue with</string>
    <string name="get_started_provider_google">Google</string>
    <string name="get_started_provider_apple">Apple</string>
    <string name="get_started_provider_microsoft">Microsoft</string>
    <string name="get_started_coming_soon_label">Coming soon</string>

    <!--
        Shown when a first-run action exists in the design but has no
        implementation yet. The placeholder is the action or provider name.
    -->
    <string name="get_started_coming_soon">%1$s is not available yet — coming soon.</string>

    <!-- Shared navigation -->
    <string name="navigate_back">Back</string>

    <!--
        Set up VaultKey flow: import an existing key. Step 1 pastes the encrypted key from
        the clipboard; step 2 collects its passphrase.
    -->
    <string name="ssh_setup_title">Setup VaultKey</string>
    <string name="ssh_setup_step_progress">STEP %1$d OF %2$d</string>
    <string name="ssh_setup_paste_body">Copy your VaultKey, then paste it from your clipboard.</string>
    <string name="ssh_setup_paste_action">Paste VaultKey</string>
    <string name="ssh_setup_passphrase_body">Enter the passphrase that protects your VaultKey.</string>
    <string name="ssh_setup_passphrase_placeholder">VaultKey Passphrase</string>
    <string name="ssh_setup_create_action">Create VaultKey</string>
    <string name="ssh_setup_retry_action">Retry backup without re-importing</string>
    <!--
        Fixed clipboard and key-format errors. They never echo the pasted key or any other
        secret. The clear-failure and unsupported-container wording matches the Confirm
        Backup flow, which performs the same clipboard handling.
    -->
    <string name="ssh_setup_clipboard_read_error">Vault could not read the clipboard. Copy the private key and try again.</string>
    <string name="ssh_setup_clipboard_clear_error">Vault could not clear the clipboard. Clear it manually, then try again.</string>
    <string name="ssh_setup_clipboard_empty_error">The clipboard does not contain a private key. Copy the key and try again.</string>
    <string name="ssh_setup_clipboard_invalid_error">The clipboard does not contain a supported encrypted Ed25519 OpenSSH private key.</string>

    <!-- Create VaultKey flow: step 1, "Getting Started" intro/consent screen -->
    <string name="create_vault_key_intro_icon_description">Pen and paper reminder</string>
    <string name="create_vault_key_intro_title">Getting Started</string>
    <string name="create_vault_key_intro_body1">Grab a pen and paper to prepare for the backup process.</string>
    <string name="create_vault_key_intro_body2">Before manually writing down your secret combinations make sure you are somewhere safe with no people or cameras nearby. </string>
    <string name="create_vault_key_intro_warning">Warning: Backup is unrecoverable if lost.</string>
    <string name="create_vault_key_intro_consent">I understand that if I lose this information no one can help me recover it.</string>
    <string name="create_vault_key_intro_confirm">Confirm</string>

    <!-- Create VaultKey flow: shared passphrase-field accessibility labels -->
    <string name="create_vault_key_passphrase_show">Show passphrase</string>
    <string name="create_vault_key_passphrase_hide">Hide passphrase</string>

    <!-- Create VaultKey flow: step 2, choose the VaultKey passphrase -->
    <string name="create_vault_key_passphrase_title">Create Passphrase</string>
    <string name="create_vault_key_passphrase_icon_description">Padlock</string>
    <string name="create_vault_key_passphrase_label">Create Passphrase</string>
    <!--
        The length floor is substituted from VaultKeyPassphrasePolicy.MINIMUM_LENGTH so the
        displayed number cannot drift away from the rule actually enforced. Ignored as a plural
        candidate on purpose: the value is a fixed policy constant, never a count, so only one
        form ever exists and a plural resource would add indirection for nothing.
    -->
    <string name="create_vault_key_passphrase_rule_min_length" tools:ignore="PluralsCandidate">Minimum %1$d characters</string>
    <!--
        Strength meter labels. The first three describe scores below
        VaultKeyPassphrasePolicy.MINIMUM_STRENGTH_SCORE, so none of them may read as approval:
        the meter must never describe a passphrase as strong while Confirm is still hidden.
    -->
    <string name="create_vault_key_passphrase_strength_very_weak">Very weak</string>
    <string name="create_vault_key_passphrase_strength_weak">Weak</string>
    <string name="create_vault_key_passphrase_strength_not_strong_enough">Not strong enough</string>
    <string name="create_vault_key_passphrase_strength_strong">Strong</string>
    <string name="create_vault_key_passphrase_strength_very_strong">Very strong</string>
    <!--
        The meter's label row. States the band in words; the crack-time estimate lives in the
        details sheet, so this line stays a plain verdict rather than pairing it with a number.
    -->
    <string name="create_vault_key_passphrase_meter_summary">Passphrase Strength: %1$s</string>
    <string name="create_vault_key_passphrase_details_open">Why this rating</string>

    <!--
        Crack-time wording. The unit is chosen in code (`crackTimeOf`) and rendered here so
        plurals stay correct; zxcvbn ships its own display strings, but they are English-only
        library text with no plural forms.
    -->
    <string name="create_vault_key_passphrase_crack_time_instant">less than a second</string>
    <string name="create_vault_key_passphrase_crack_time_centuries">centuries</string>
    <plurals name="create_vault_key_passphrase_crack_time_seconds">
        <item quantity="one">%1$d second</item>
        <item quantity="other">%1$d seconds</item>
    </plurals>
    <plurals name="create_vault_key_passphrase_crack_time_minutes">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
    <plurals name="create_vault_key_passphrase_crack_time_hours">
        <item quantity="one">%1$d hour</item>
        <item quantity="other">%1$d hours</item>
    </plurals>
    <plurals name="create_vault_key_passphrase_crack_time_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
    <plurals name="create_vault_key_passphrase_crack_time_months">
        <item quantity="one">%1$d month</item>
        <item quantity="other">%1$d months</item>
    </plurals>
    <plurals name="create_vault_key_passphrase_crack_time_years">
        <item quantity="one">%1$d year</item>
        <item quantity="other">%1$d years</item>
    </plurals>

    <!-- Create VaultKey flow: the "why this rating" explanation sheet -->
    <string name="create_vault_key_passphrase_details_title">Passphrase strength</string>
    <string name="create_vault_key_passphrase_details_close">Close</string>
    <string name="create_vault_key_passphrase_details_score">Strength score</string>
    <string name="create_vault_key_passphrase_details_score_value">%1$d of %2$d</string>
    <string name="create_vault_key_passphrase_details_time_to_crack">Time to crack</string>
    <!--
        Both rows describe an offline attack on a stolen backup with many cores; only the hash the
        backup is protected by differs. The first row is the real situation, the second shows what a
        weak hash would cost.
    -->
    <string name="create_vault_key_passphrase_details_attack_slow_hash">Slow hash (10,000 guesses per second)</string>
    <string name="create_vault_key_passphrase_details_attack_fast_hash">Fast hash (10 billion guesses per second)</string>
    <string name="create_vault_key_passphrase_details_noticed">What we noticed</string>
    <string name="create_vault_key_passphrase_details_nothing_noticed">No predictable patterns found.</string>
    <string name="create_vault_key_passphrase_details_improve">How to improve it</string>

    <!--
        Plain-language names for the kinds of structure zxcvbn can recognize. Named here rather
        than taken from the library so the wording and the plurals stay app-owned.
    -->
    <string name="create_vault_key_passphrase_finding_common_password">A commonly used password</string>
    <string name="create_vault_key_passphrase_finding_common_word">A common word or name</string>
    <string name="create_vault_key_passphrase_finding_reversed_word">A common word spelled backwards</string>
    <string name="create_vault_key_passphrase_finding_substituted_word">A common word with character substitutions</string>
    <string name="create_vault_key_passphrase_finding_keyboard_pattern">A keyboard pattern</string>
    <string name="create_vault_key_passphrase_finding_repeated_characters">Repeated characters</string>
    <string name="create_vault_key_passphrase_finding_predictable_sequence">A predictable sequence</string>
    <string name="create_vault_key_passphrase_finding_date">A date</string>
    <string name="create_vault_key_passphrase_finding_recent_year">A recent year</string>
    <!-- Not a weakness: the stretch the estimator could not explain. -->
    <string name="create_vault_key_passphrase_finding_unpredictable_characters">Unpredictable characters</string>
    <plurals name="create_vault_key_passphrase_finding_characters">
        <item quantity="one">%1$d character</item>
        <item quantity="other">%1$d characters</item>
    </plurals>
    <string name="create_vault_key_passphrase_finding_guesses">%1$s guesses</string>
    <!--
        Wraps the matched text so its boundaries are visible when it starts or ends with spaces or
        punctuation, which several real matches do.
    -->
    <string name="create_vault_key_passphrase_finding_token">\"%1$s\"</string>
    <string name="create_vault_key_passphrase_finding_keyboard">%1$s keyboard</string>
    <plurals name="create_vault_key_passphrase_finding_turns">
        <item quantity="one">%1$d turn</item>
        <item quantity="other">%1$d turns</item>
    </plurals>
    <plurals name="create_vault_key_passphrase_finding_repeats">
        <item quantity="one">repeats %1$d time</item>
        <item quantity="other">repeats %1$d times</item>
    </plurals>
    <string name="create_vault_key_passphrase_finding_ascending">ascending</string>
    <string name="create_vault_key_passphrase_finding_descending">descending</string>
    <!--
        zxcvbn's own pattern names, shown next to the plain-language kind so a reader can see both
        what the estimator matched and what it means.
    -->
    <string name="create_vault_key_passphrase_pattern_dictionary">Dictionary</string>
    <string name="create_vault_key_passphrase_pattern_spatial">Spatial</string>
    <string name="create_vault_key_passphrase_pattern_repeat">Repeat</string>
    <string name="create_vault_key_passphrase_pattern_sequence">Sequence</string>
    <string name="create_vault_key_passphrase_pattern_regex">Regex</string>
    <string name="create_vault_key_passphrase_pattern_date">Date</string>
    <string name="create_vault_key_passphrase_pattern_bruteforce">Bruteforce</string>

    <!--
        Friendly names for zxcvbn's internal dictionary identifiers, which ship as values like
        "us_tv_and_film". An unrecognized name falls back to the raw identifier in code.
    -->
    <string name="create_vault_key_passphrase_dictionary_passwords">Common passwords</string>
    <string name="create_vault_key_passphrase_dictionary_english_wikipedia">Common English words</string>
    <string name="create_vault_key_passphrase_dictionary_us_tv_and_film">TV and film titles</string>
    <string name="create_vault_key_passphrase_dictionary_surnames">Surnames</string>
    <string name="create_vault_key_passphrase_dictionary_female_names">Female first names</string>
    <string name="create_vault_key_passphrase_dictionary_male_names">Male first names</string>
    <string name="create_vault_key_passphrase_dictionary_rank">%1$s #%2$d</string>
    <string name="create_vault_key_passphrase_rule_satisfied">%1$s, satisfied</string>
    <string name="create_vault_key_passphrase_rule_pending">%1$s, still required</string>
    <string name="create_vault_key_passphrase_confirm">Confirm</string>

    <!-- Create VaultKey flow: step 3, re-enter the passphrase -->
    <string name="create_vault_key_confirm_passphrase_title">Re-enter Passphrase</string>
    <string name="create_vault_key_confirm_passphrase_icon_description">Padlock inside a repeat arrow</string>
    <string name="create_vault_key_confirm_passphrase_verify">Verify</string>
    <string name="create_vault_key_confirm_passphrase_generating">Creating VaultKey…</string>
    <string name="create_vault_key_confirm_passphrase_mismatch">Passphrase does not match. Please re-enter.</string>
    <!-- Deliberately generic: an underlying crypto error must not echo key or passphrase material. -->
    <string name="create_vault_key_confirm_passphrase_generation_failed">VaultKey creation failed. Please try again.</string>

    <!-- Create VaultKey flow: irreversible account creation progress -->
    <string name="create_vault_key_creating_title">Creating VaultKey</string>
    <string name="create_vault_key_creating_warning">Warning: Don’t close the app during this process.</string>
    <string name="create_vault_key_creating_key">Created Encrypted VaultKey</string>
    <string name="create_vault_key_deriving_nostr">Derived Nostr Key Pair</string>
    <string name="create_vault_key_deriving_sync_code">Derived Sync Code</string>
    <string name="create_vault_key_backup_relay">Backup VaultKey to Nostr Relay %1$d</string>
    <string name="create_vault_key_backup_sync_server">Backup VaultKey to Sync Server %1$d</string>
    <string name="create_vault_key_created_successfully">VaultKey created successfully</string>
    <string name="create_vault_key_operation_in_progress">VaultKey creation in progress</string>

    <!-- Create VaultKey flow: step 4, export the first Vault Backup -->
    <string name="create_vault_key_backup_intro_title">Create Backup</string>
    <string name="create_vault_key_backup_intro_icon_description">Safe with a combination dial</string>
    <string name="create_vault_key_backup_intro_body1">Your first VaultKey Backup is a digital backup that requires you to store it safely somewhere on your device. </string>
    <string name="create_vault_key_backup_intro_body2">Any of your preferred encrypted note apps with additional security will suffice for this step. </string>
    <string name="create_vault_key_backup_intro_confirm">Export VaultKey</string>
    <string name="create_vault_key_backup_no_targets">No installed app can receive text exports.</string>
    <string name="create_vault_key_backup_target_title">Export VaultKey with</string>
    <string name="create_vault_key_backup_target_cancel">Cancel</string>
    <string name="create_vault_key_backup_target_missing">That app is no longer available. Choose another app.</string>
    <string name="create_vault_key_backup_target_denied">Android did not allow this app to receive the export. Choose another app.</string>
    <string name="create_vault_key_backup_unavailable">The VaultKey is unavailable. Restart Vault and try again.</string>

    <!-- Create VaultKey flow: step 5, verify the exported backup -->
    <string name="create_vault_key_confirm_backup_title">Confirm Backup</string>
    <string name="create_vault_key_confirm_backup_icon_description">Backup confirmation shield</string>
    <string name="create_vault_key_confirm_backup_body">To confirm you have safely exported and stored your Backup, please upload it below by clicking on the button.</string>
    <string name="create_vault_key_confirm_backup_action">Paste VaultKey</string>
    <string name="create_vault_key_confirm_backup_read_error">Vault could not read the clipboard. Copy the VaultKey and try again.</string>
    <string name="create_vault_key_confirm_backup_clear_error">Vault could not clear the clipboard. Clear it manually, then try again.</string>
    <string name="create_vault_key_confirm_backup_empty_error">The clipboard does not contain a private key. Copy the VaultKey and try again.</string>
    <string name="create_vault_key_confirm_backup_invalid_error">The clipboard does not contain a supported encrypted Ed25519 OpenSSH private key.</string>
    <string name="create_vault_key_confirm_backup_mismatch_error">This VaultKey does not match the backup you just exported.</string>
    <string name="create_vault_key_confirm_backup_locked_title">Vault temporarily blocked</string>
    <string name="create_vault_key_confirm_backup_locked_body">You pasted invalid VaultKey. Try again in %1$s.</string>

    <!-- Create VaultKey flow: step 6, transcribe Vault Key backup recovery word positions -->
    <string name="create_vault_key_secret_combinations_title">Secret Combinations</string>
    <string name="create_vault_key_secret_combinations_warning_title">Warning: </string>
    <string name="create_vault_key_secret_combinations_warning_body">Write down all 8 combinations correctly and store them offline. If they are lost VaultKey cannot be recovered.</string>
    <string name="create_vault_key_secret_combinations_instruction">Scroll to view all 8 combinations</string>
    <string name="create_vault_key_secret_combinations_consent">I have saved all 8 Secret Combinations</string>
    <string name="create_vault_key_secret_combinations_confirm">Continue</string>
    <string name="create_vault_key_secret_combinations_unavailable">Secret Combinations are unavailable. Restart Vault and try again.</string>

    <!-- Create VaultKey flow: step 7, verify every secret combination -->
    <string name="create_vault_key_confirm_secret_combinations_title">Secret Combinations</string>
    <string name="create_vault_key_confirm_secret_combinations_body">Confirm your Secret Combinations accurately. Every input must be correct</string>
    <string name="create_vault_key_confirm_secret_combinations_incorrect">Incorrect Secret Combination! Please try again.</string>

    <!-- Settings Secret Combinations review flow -->
    <string name="secret_combinations_verify_title">Secret Combinations</string>
    <string name="secret_combinations_verify_body">Re-enter the passphrase that protects your VaultKey before its Secret Combinations are shown.</string>
    <string name="secret_combinations_verify_label">VaultKey Passphrase</string>
    <string name="secret_combinations_verify_action">Verify Passphrase</string>
    <string name="secret_combinations_verify_error">That passphrase does not match this VaultKey.</string>
    <string name="secret_combinations_verify_show">Show passphrase</string>
    <string name="secret_combinations_verify_hide">Hide passphrase</string>
    <string name="secret_combinations_confirm_body">Enter the Secret Combinations you just wrote down. Every input has to be correct before this flow can finish.</string>
    <string name="secret_combinations_complete_icon_description">Secret Combinations verified</string>
    <string name="secret_combinations_unavailable_exit">Back to Settings</string>
</resources>
