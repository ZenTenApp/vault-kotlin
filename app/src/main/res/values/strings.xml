    <string name="create_master_key_backup_target_missing">That app is no longer available. Choose another app.</string>
    <string name="create_master_key_backup_target_denied">Android did not allow this app to receive the export. Choose another app.</string>
    <string name="create_master_key_backup_unavailable">The MasterKey is unavailable. Restart Vault and try again.</string>

    <!-- Create MasterKey flow: step 5, verify the exported backup -->
    <string name="create_master_key_confirm_backup_title">Confirm Backup</string>
    <string name="create_master_key_confirm_backup_icon_description">Backup confirmation shield</string>
    <string name="create_master_key_confirm_backup_body">To confirm you have safely exported and stored your Backup, please upload it below by clicking on the button.</string>
