    <string name="create_master_key_intro_body2">Before manually writing down your secret combinations make sure you are somewhere safe with no people or cameras nearby. </string>
    <string name="create_master_key_intro_warning">Warning: Backup is unrecoverable if lost.</string>
    <string name="create_master_key_intro_consent">I understand that if I lose this information no one can help me recover it.</string>
