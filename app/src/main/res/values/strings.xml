    <string name="create_master_key_confirm_passphrase_title">Confirm Passphrase</string>
    <string name="create_master_key_confirm_passphrase_icon_description">Padlock inside a repeat arrow</string>
    <string name="create_master_key_confirm_passphrase_label">Re-enter Passphrase</string>
    <string name="create_master_key_confirm_passphrase_verify">Verify</string>
