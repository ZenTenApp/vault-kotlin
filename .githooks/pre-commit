#!/usr/bin/env bash
# Pre-commit secret scan: runs Gitleaks on the staged changes only, so a
# secret is blocked BEFORE it enters git history (CI's full-history scan
# only finds it after the fact). Uses the same config and pinned version as
# .github/workflows/security.yml. Enable once per clone with:
#   git config core.hooksPath .githooks
# Bypass in an emergency with `git commit --no-verify` (CI still scans).
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Single source of truth for the version, shared with CI
# (.github/workflows/security.yml reads the same file).
GITLEAKS_IMAGE="ghcr.io/gitleaks/gitleaks:$(tr -d '[:space:]' < .gitleaks-version)"

# --staged scans the index (what is about to be committed), not the working
# tree; --redact keeps matched secrets out of the terminal output.
args=(git --pre-commit --staged --redact --verbose --no-banner --config .gitleaks.toml)

if command -v gitleaks >/dev/null 2>&1; then
  # Fastest path: a locally installed binary.
  gitleaks "${args[@]}" .
elif command -v docker >/dev/null 2>&1; then
  # Fallback: the same pinned container image CI uses. Run as the current
  # user so git does not reject the mounted repo as "dubious ownership".
  docker run --rm --user "$(id -u):$(id -g)" -v "$repo_root:/repo" -w /repo \
    "$GITLEAKS_IMAGE" "${args[@]}" /repo
else
  # Fail closed: silently skipping would defeat the purpose of the hook.
  echo "pre-commit: neither 'gitleaks' nor 'docker' found; cannot scan staged changes." >&2
  echo "Install gitleaks (https://github.com/gitleaks/gitleaks) or bypass with --no-verify." >&2
  exit 1
fi
